{
    "headers": [
      {
        "source": "/*",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Cache-Control",
            "value": "max-age=60"
          }
        ]
      }
    ],
     "caches": [
    {
      "source": "/*",
      "cacheTtl": 60
    }
  ]
}